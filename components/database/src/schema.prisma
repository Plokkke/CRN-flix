generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String   @db.VarChar(255)
  jellyfinId          String?  @unique @map("jellyfin_id") @db.VarChar(255)
  messagingKey        String   @map("messaging_key") @db.VarChar(255)
  messagingId         String   @map("messaging_id") @db.VarChar(255)
  discordMessageId    String?  @unique @map("discord_message_id") @db.VarChar(255)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  userActivities      UserActivity[]
  requestUsers        RequestUser[]

  @@unique([messagingKey, messagingId])
  @@map("users")
}

model UserActivity {
  userId    String                 @map("user_id") @db.Uuid
  type      UserActivityType
  updatedAt DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
  @@map("user_activities")
}

model Media {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imdbId         String   @map("imdb_id") @db.VarChar(32)
  type           MediaType
  title          String   @db.VarChar(255)
  originalTitle  String?  @map("original_title") @db.VarChar(255)
  year           Int?
  seasonNumber   Int?     @map("season_number")
  episodeNumber  Int?     @map("episode_number")
  runtimeMinutes Int?     @map("runtime_minutes")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  mediaRequest  MediaRequest?

  @@unique([imdbId, seasonNumber, episodeNumber], name: "medias_unique_idx")
  @@map("medias")
}

model MediaRequest {
  mediaId            String              @id @map("media_id") @db.Uuid
  status             MediaRequestStatus  @default(missing)
  discordMessageId   String?             @map("discord_message_id") @db.VarChar(50)
  indexerName        String?             @map("indexer_name")
  indexerLink        String?             @map("indexer_link")
  downloadJobId      String?             @map("download_job_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  media         Media           @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  downloadJob   DownloadJob?    @relation(fields: [downloadJobId], references: [id], onDelete: SetNull)
  requestUsers  RequestUser[]

  @@map("media_requests")
}

model UserNotification {
  userId  String   @map("user_id") @db.Uuid
  mediaId String   @map("media_id") @db.Uuid
  status  String   @db.VarChar(32)
  sentAt  DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  @@id([userId, mediaId, status])
  @@map("user_notifications")
}

model AdminSession {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  discordUserId String    @map("discord_user_id") @db.VarChar(64)
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt    DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@map("admin_sessions")
}

model RequestUser {
  requestMediaId String             @map("request_media_id") @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  reasons        RequestReason[]
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  mediaRequest   MediaRequest       @relation(fields: [requestMediaId], references: [mediaId], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([requestMediaId, userId])
  @@map("request_users")
}

enum UserActivityType {
  WATCHLISTED
  LISTED
  HIGH_RATED
  PROGRESS
}

enum MediaType {
  movie
  episode
}

enum MediaRequestStatus {
  pending
  fulfilled
  missing
  rejected
  canceled
}

enum RequestReason {
  WATCHLISTED
  LISTED
  HIGH_RATED
  PROGRESS
}

enum DownloadJobStatus {
  detected
  identifying
  completed
  failed
}

model NamingAuditItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auditRunId    String   @map("audit_run_id") @db.Uuid
  mediaType     String   @map("media_type")
  imdbId        String?  @map("imdb_id")
  currentPath   String   @map("current_path")
  expectedPath  String   @map("expected_path")
  reasons       String[]
  englishTitle  String?  @map("english_title")
  year          Int?
  seasonNumber  Int?     @map("season_number")
  episodeNumber Int?     @map("episode_number")
  status        String   @default("pending")
  error         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  appliedAt     DateTime? @map("applied_at") @db.Timestamptz(6)

  @@index([auditRunId])
  @@index([status])
  @@map("naming_audit_items")
}

model DownloadJob {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jdownloaderPackageId BigInt            @unique @map("jdownloader_package_id") @db.BigInt
  packageName          String            @map("package_name")
  saveTo               String            @map("save_to")
  status               DownloadJobStatus @default(detected)
  sourcePaths              String[]          @map("source_paths")
  errorMessage             String?           @map("error_message")
  discordMessageId         String?           @map("discord_message_id")
  metadata                 Json?             @db.JsonB
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  mediaRequests        MediaRequest[]

  @@map("download_jobs")
}