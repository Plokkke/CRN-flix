generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String   @db.VarChar(255)
  jellyfinId          String?  @unique @map("jellyfin_id") @db.VarChar(255)
  messagingKey        String   @map("messaging_key") @db.VarChar(255)
  messagingId         String   @map("messaging_id") @db.VarChar(255)
  status              UserStatus @default(pending)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  userActivities      UserActivity[]
  requestUsers        RequestUser[]
  showProgress        UserShowProgress[]
  sessions            UserSession[]

  @@unique([messagingKey, messagingId])
  @@map("users")
}

model UserActivity {
  userId    String                 @map("user_id") @db.Uuid
  type      UserActivityType
  updatedAt DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
  @@map("user_activities")
}

model Media {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imdbId         String   @map("imdb_id") @db.VarChar(32)
  type           MediaType
  title          String   @db.VarChar(255)
  originalTitle  String?  @map("original_title") @db.VarChar(255)
  year           Int?
  seasonNumber   Int?     @map("season_number")
  episodeNumber  Int?     @map("episode_number")
  traktSlug      String?  @map("trakt_slug") @db.VarChar(255)
  runtimeMinutes Int?     @map("runtime_minutes")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  mediaRequest          MediaRequest?
  plannedDownloadMedias PlannedDownloadMedia[]

  @@unique([imdbId, seasonNumber, episodeNumber], name: "medias_unique_idx")
  @@map("medias")
}

model MediaRequest {
  mediaId            String              @id @map("media_id") @db.Uuid
  status             MediaRequestStatus  @default(missing)
  downloadJobId      String?             @map("download_job_id") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  media         Media           @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  downloadJob   DownloadJob?    @relation(fields: [downloadJobId], references: [id], onDelete: SetNull)
  requestUsers  RequestUser[]

  @@map("media_requests")
}

model UserShowProgress {
  userId      String   @map("user_id") @db.Uuid
  showImdbId  String   @map("show_imdb_id") @db.VarChar(32)
  nextSeason  Int?     @map("next_season")
  nextEpisode Int?     @map("next_episode")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, showImdbId])
  @@map("user_show_progress")
}

model PlannedDownload {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  showImdbId       String?              @map("show_imdb_id") @db.VarChar(32)
  scope            PlannedDownloadScope
  seasonNumber     Int?                 @map("season_number")
  episodeNumber    Int?                 @map("episode_number")
  indexerName      String               @map("indexer_name")
  url              String
  quality          String               @db.VarChar(16)
  host          String   @default("1fichier") @db.VarChar(32)
  language         String               @db.VarChar(16)
  sizeBytes        BigInt?              @map("size_bytes") @db.BigInt
  label            PlannedDownloadLabel
  status           PlannedDownloadStatus @default(proposed)
  alternatives     Json                 @default("[]") @db.JsonB
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  medias PlannedDownloadMedia[]

  @@index([showImdbId])
  @@map("planned_downloads")
}

model PlannedDownloadMedia {
  plannedDownloadId String @map("planned_download_id") @db.Uuid
  mediaId           String @map("media_id") @db.Uuid

  plannedDownload PlannedDownload @relation(fields: [plannedDownloadId], references: [id], onDelete: Cascade)
  media           Media           @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([plannedDownloadId, mediaId])
  @@map("planned_download_medias")
}

model UserNotification {
  userId  String   @map("user_id") @db.Uuid
  mediaId String   @map("media_id") @db.Uuid
  status  String   @db.VarChar(32)
  sentAt  DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  @@id([userId, mediaId, status])
  @@map("user_notifications")
}

model AdminSession {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  discordUserId String    @map("discord_user_id") @db.VarChar(64)
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt    DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@map("admin_sessions")
}

model IndexerBookmark {
  indexerName String   @map("indexer_name") @db.VarChar(64)
  imdbId      String   @map("imdb_id") @db.VarChar(32)
  pageUrl     String?  @map("page_url")
  searchUrl   String?  @map("search_url")
  state       Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([indexerName, imdbId])
  @@index([imdbId])
  @@map("indexer_bookmarks")
}

model MediaRequestState {
  mediaId       String   @id @map("media_id") @db.Uuid
  urgency       String   @db.VarChar(16)
  sourcing      String   @db.VarChar(16)
  bestCandidate Json?    @map("best_candidate") @db.JsonB
  bestRejected  Json?    @map("best_rejected") @db.JsonB
  actionId      String?  @map("action_id") @db.Uuid
  plannedAt     DateTime @default(now()) @map("planned_at") @db.Timestamptz(6)

  @@index([sourcing])
  @@map("media_request_states")
}

model PlannerFinding {
  targetKey  String   @id @map("target_key") @db.VarChar(64)
  candidates Json     @db.JsonB
  referenced Boolean  @default(false)
  foundAt    DateTime @default(now()) @map("found_at") @db.Timestamptz(6)

  @@map("planner_findings")
}

model UserSession {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id") @db.Uuid
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model RequestUser {
  requestMediaId String             @map("request_media_id") @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  reasons        RequestReason[]
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  mediaRequest   MediaRequest       @relation(fields: [requestMediaId], references: [mediaId], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([requestMediaId, userId])
  @@map("request_users")
}

model Ticket {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category    TicketCategory
  subjectType String?      @map("subject_type") @db.VarChar(32)
  subjectId   String?      @map("subject_id") @db.VarChar(64)
  status      TicketStatus @default(open)
  title       String
  summary     String?
  payload     Json         @default("{}") @db.JsonB
  attempts    Int          @default(0)
  resolution  String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  resolvedAt  DateTime?    @map("resolved_at") @db.Timestamptz(6)

  events   TicketEvent[]
  bindings TicketBinding[]

  @@map("tickets")
}

model TicketEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  kind      String   @db.VarChar(32)
  actor     String   @db.VarChar(80)
  message   String
  data      Json     @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_events")
}

model TicketBinding {
  ticketId   String   @map("ticket_id") @db.Uuid
  adapter    String   @db.VarChar(16)
  kind       String   @db.VarChar(16)
  externalId String   @map("external_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@id([ticketId, adapter, kind])
  @@unique([adapter, externalId])
  @@map("ticket_bindings")
}

enum UserStatus {
  pending
  active
}

enum TicketCategory {
  user_approval          @map("user-approval")
  download_action        @map("download-action")
  identification_failure @map("identification-failure")
  pipeline_failure       @map("pipeline-failure")
  manual_download        @map("manual-download")
  missing_imdb           @map("missing-imdb")
}

enum TicketStatus {
  open
  resolved
  abandoned
}

enum UserActivityType {
  WATCHLISTED
  LISTED
  HIGH_RATED
  PROGRESS
}

enum MediaType {
  movie
  episode
}

enum MediaRequestStatus {
  pending
  fulfilled
  missing
  rejected
}

enum PlannedDownloadScope {
  movie
  episode
  season
  series
}

enum PlannedDownloadLabel {
  starved
  needed
  deferred
}

enum PlannedDownloadStatus {
  proposed
  downloading
  done
  superseded
  expired
}

enum RequestReason {
  WATCHLISTED
  LISTED
  HIGH_RATED
  PROGRESS
}

enum DownloadJobStatus {
  detected
  identifying
  completed
  failed
}

model NamingAuditItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auditRunId    String   @map("audit_run_id") @db.Uuid
  mediaType     String   @map("media_type")
  imdbId        String?  @map("imdb_id")
  currentPath   String   @map("current_path")
  expectedPath  String   @map("expected_path")
  reasons       String[]
  englishTitle  String?  @map("english_title")
  year          Int?
  seasonNumber  Int?     @map("season_number")
  episodeNumber Int?     @map("episode_number")
  status        String   @default("pending")
  error         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  appliedAt     DateTime? @map("applied_at") @db.Timestamptz(6)

  @@index([auditRunId])
  @@index([status])
  @@map("naming_audit_items")
}

model DownloadJob {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId             String            @unique @map("source_id")
  packageName          String            @map("package_name")
  saveTo               String            @map("save_to")
  status               DownloadJobStatus @default(detected)
  sourcePaths              String[]          @map("source_paths")
  errorMessage             String?           @map("error_message")
  metadata                 Json?             @db.JsonB
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  mediaRequests        MediaRequest[]

  @@map("download_jobs")
}