{
  "private": true,
  "name": "@crn-flix/api",
  "version": "1.0.3-draft.0",
  "author": "Antoine Caron <antoine@crn-tech.fr>",
  "license": "ISC",
  "description": "CRN-Flix is an application server managing a user list for Jellyfin media server and centralizing media requests from Trakt.",
  "main": "dist/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Plokkke/CRN-flix.git"
  },
  "scripts": {
    "build": "nest build",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "start": "nest start --env-file .env",
    "start:dev": "npm run start -- --watch",
    "start:debug": "npm run start:dev -- --debug",
    "start:prod": "node dist/main",
    "once": "nest start --env-file .env -- --once",
    "test": "npm run test:unit",
    "test:cov": "npm run test:unit:cov && npm run test:mut",
    "test:unit": "jest --passWithNoTests --config ./test/jest-unit.js",
    "test:unit:cov": "npm run test:unit -- --coverage",
    "test:mut": "stryker run",
    "validate": "npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/platform-express": "^11.1.17",
    "@plokkke/nest-health-registry": "^1.0.3",
    "axios": "^1.13.6",
    "chalk": "^5.6.2",
    "discord.js": "^14.25.1",
    "lodash": "^4.17.23",
    "luxon": "^3.7.2",
    "nest-winston": "^1.10.2",
    "nestjs-zod": "^5.2.1",
    "nodemailer": "^8.0.4",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "winston": "^3.19.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.17",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/jest-runner": "^9.6.0",
    "@stryker-mutator/typescript-checker": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.24",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.12.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "dotenv-expand": "^12.0.3",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.3.0",
    "prettier": "^3.8.1",
    "semantic-release": "^25.0.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2"
  }
}
