{
  "private": true,
  "name": "@crn-flix/api",
  "version": "0.0.0",
  "author": "Antoine Caron <antoine@crn-tech.fr>",
  "license": "ISC",
  "description": "CRN-Flix engine: turns catalog requests into downloads and notifies requesters when they become available.",
  "main": "dist/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Plokkke/CRN-flix.git"
  },
  "scripts": {
    "build": "nest build",
    "clean": "rm -rf dist reports",
    "dev": "nest start --env-file .env --watch",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "lint:fix": "pnpm run lint --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "nest start --env-file .env",
    "start:debug": "pnpm run dev --debug",
    "start:prod": "node dist/main",
    "once": "nest start --env-file .env -- --once",
    "indexer:find": "node --env-file .env -r ts-node/register/transpile-only -r tsconfig-paths/register src/modules/indexer/dev-cli.ts",
    "test": "jest",
    "test:cov": "jest --coverage && stryker run",
    "test:mut": "stryker run"
  },
  "dependencies": {
    "@crn-flix/catalog-trakt": "workspace:*",
    "@crn-flix/contracts": "workspace:*",
    "@crn-flix/design-system": "workspace:*",
    "@crn-flix/discord": "workspace:*",
    "@crn-flix/downloader-fetchr": "workspace:*",
    "@crn-flix/http": "workspace:*",
    "@crn-flix/indexer-loadix": "workspace:*",
    "@crn-flix/layout-jellyfin": "workspace:*",
    "@crn-flix/messaging-admin-discord": "workspace:*",
    "@crn-flix/messaging-user-email": "workspace:*",
    "@crn-flix/metadata-tmdb": "workspace:*",
    "@crn-flix/planner": "workspace:*",
    "@crn-flix/player-jellyfin": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "4.0.3",
    "@nestjs/core": "11.1.17",
    "@nestjs/platform-express": "11.1.17",
    "@nestjs/schedule": "6.1.1",
    "@plokkke/nest-health-registry": "1.0.3",
    "axios": "catalog:",
    "chalk": "5.6.2",
    "cron": "4.4.0",
    "discord.js": "14.25.1",
    "lodash": "4.17.23",
    "logform": "2.7.0",
    "luxon": "3.7.2",
    "nest-winston": "1.10.2",
    "nestjs-zod": "5.2.1",
    "parse-torrent-title": "2.1.0",
    "pg": "8.20.0",
    "reflect-metadata": "0.2.2",
    "winston": "3.19.0",
    "yaml": "2.8.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@crn-flix/tooling": "workspace:*",
    "@nestjs/cli": "11.0.16",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.17",
    "@stryker-mutator/core": "9.6.0",
    "@stryker-mutator/jest-runner": "9.6.0",
    "@stryker-mutator/typescript-checker": "9.6.0",
    "@types/express": "5.0.6",
    "@types/jest": "catalog:",
    "@types/lodash": "4.17.24",
    "@types/luxon": "3.7.1",
    "@types/node": "catalog:",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.0",
    "dotenv-expand": "12.0.3",
    "eslint": "catalog:",
    "jest": "catalog:",
    "supertest": "7.2.2",
    "ts-jest": "catalog:",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "catalog:"
  }
}
