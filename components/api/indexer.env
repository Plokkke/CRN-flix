# Settings of `pnpm indexer:find`, no secret (Loadix needs no account). Same values as the production
# defaults in infrastructure/terraform/variables.tf (`loadix`, `indexer_preferences`): keep them in step.
# A variable set in the shell wins, e.g. `INDEXER_ALLOWED_QUALITIES= pnpm indexer:find …` to allow every quality.
LOADIX_API_HOST=https://api.loadix.fun
LOADIX_SITE_HOST=https://loadix.fun
INDEXER_ALLOWED_QUALITIES=hd-1080p
INDEXER_ALLOWED_LANGUAGES=truefrench,multi,french
INDEXER_ALLOWED_HOSTS=1fichier
INDEXER_SIZE_TOLERANCE=1.25
INDEXER_BYTES_PER_MIN_JSON={"uhd-4k":80000000,"hd-1080p":24000000,"hd-720p":12000000,"sd":6000000}
