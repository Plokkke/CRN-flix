# Keys of /srv/docker/crn-flix/.env read by docker-compose.yaml. Secrets are left empty: never commit values.

# --- Host ---
PUID=1000
PGID=1000
# Persistent config (jellyfin/config, postgres/data)
HOST_CONFIG_PATH=/srv/docker/crn-flix/volumes
# Media disk: one filesystem holding downloads/ and medias/ (atomic moves)
HOST_DATA_PATH=/mnt/disk18to
# Where fetchr sees HOST_DATA_PATH/downloads; the engine maps fetchr paths with it
FETCHR_DOWNLOAD_PATH=/downloads

# --- Engine ---
ENGINE_LOG_LEVEL=info
ENGINE_SERVER_URL=
ENGINE_SERVICE_NAME=
TRAKT_HOST=
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
JELLYFIN_URL=
JELLYFIN_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_BOT_TOKEN=
DISCORD_ADMIN_IDS=
GMAIL_USER=
GMAIL_PASSWORD=
TMDB_API_KEY=
INDEXER_ALLOWED_QUALITIES=
INDEXER_ALLOWED_LANGUAGES=
INDEXER_ALLOWED_HOSTS=
INDEXER_SIZE_TOLERANCE=1
INDEXER_BYTES_PER_MIN_JSON=
LOADIX_API_HOST=
LOADIX_SITE_HOST=

# --- Database ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Fetchr (own stack: Plokkke/fetchr) ---
# Same value as fetchr's api_key secret
FETCHR_API_KEY=
