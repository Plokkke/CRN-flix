# Example Terraform variables file
# Copy this file to terraform.tfvars and update the values

docker_host = "unix:///var/run/docker.sock"
slug = "your-flix"
service_name = "Your Flix"

postgres_version = "15-alpine"
api_version = "latest"

server_url = "https://your-flix.host.com"
sync_interval_ms = 600000

# Trakt configuration
trakt_client_id = "your-trakt-client-id"
trakt_client_secret = "your-trakt-client-secret"

# Jellyfin configuration
jellyfin_host = "https://jellyfin.host.com"
jellyfin_token = "your-jellyfin-api-key"
jellyfin_login = "AdminLogin"
jellyfin_password = "your-jellyfin-password"

# Discord configuration
discord_channel_id = "your-discord-channel-id"
discord_bot_token = "your-discord-bot-token"
discord_admin_ids = "your-admin-user-ids"

# Gmail configuration
gmail_email = "your-email@gmail.com"
gmail_password = "your-email-password"

# ClickUp configuration
clickup_api_token = "your-clickup-api-token"
clickup_team_id = "your-clickup-team-id"
clickup_list_id = "your-clickup-list-id"